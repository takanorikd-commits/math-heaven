<Window x:Class="MedicalSchoolApp.Windows.Views.ParentSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="保護者設定" Height="720" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#334155"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#334155"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <!-- Lock panel -->
        <StackPanel x:Name="LockPanel" VerticalAlignment="Center">
            <TextBlock Text="保護者設定" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
            <TextBlock Text="保護者パスワードを入力してください" Foreground="#94A3B8" Margin="0,0,0,8"/>
            <PasswordBox x:Name="PasswordInputBox" Margin="0,0,0,8" KeyDown="PasswordInputBox_KeyDown"/>
            <TextBlock x:Name="UnlockErrorText" Foreground="#EF4444" Visibility="Collapsed" Margin="0,0,0,8"/>
            <Button Content="ログイン" Click="UnlockButton_Click"/>
        </StackPanel>

        <!-- Settings panel -->
        <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="保護者設定" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

                <TextBlock Text="1日の使用可能時間（分）" Margin="0,0,0,4"/>
                <TextBox x:Name="DailyLimitBox" Margin="0,0,0,16"/>

                <TextBlock Text="共通テストの日付" Margin="0,0,0,4"/>
                <DatePicker x:Name="ExamDatePicker" Margin="0,0,0,16"/>

                <CheckBox x:Name="AutostartCheckBox" Content="Windowsログイン時に自動起動する" Foreground="White" Margin="0,0,0,16"/>

                <TextBlock Text="曜日別勉強時間" FontSize="16" FontWeight="Bold" Margin="0,8,0,8"/>
                <StackPanel x:Name="WeekdayPanel" Margin="0,0,0,16"/>

                <TextBlock Text="許可アプリ設定" FontSize="16" FontWeight="Bold" Margin="0,8,0,4"/>
                <TextBlock Text="ここにないアプリは、勉強時間中および60分超過後に自動的に終了されます（例: Chrome, Edge, Firefox, Discord, Steam, Epic Gamesなど）" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="NewAllowedAppBox" KeyDown="NewAllowedAppBox_KeyDown"/>
                    <Button Grid.Column="2" Content="追加" Click="AddAllowedAppButton_Click"/>
                </Grid>
                <ListBox x:Name="AllowedAppsListBox" Height="120" Margin="0,0,0,4" Background="#1E293B" Foreground="White"/>
                <Button Content="選択したアプリを削除" Click="RemoveAllowedAppButton_Click" Margin="0,0,0,16" Background="#334155"/>

                <Button Content="設定を保存" Click="SaveButton_Click" Background="#10B981" Padding="12" FontSize="14" Margin="0,0,0,24"/>

                <TextBlock Text="保護者パスワードの変更" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="現在のパスワード" Margin="0,0,0,4"/>
                <PasswordBox x:Name="OldPasswordBox" Margin="0,0,0,8"/>
                <TextBlock Text="新しいパスワード" Margin="0,0,0,4"/>
                <PasswordBox x:Name="NewPasswordBox" Margin="0,0,0,8"/>
                <Button Content="変更する" Click="ChangePasswordButton_Click" Margin="0,0,0,4"/>
                <TextBlock x:Name="PasswordChangeMessage" Foreground="#94A3B8" Margin="0,0,0,24"/>

                <TextBlock Text="一時パスワードを発行" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="延長する分数" Margin="0,0,0,4"/>
                <TextBox x:Name="ExtendMinutesBox" Text="15" Margin="0,0,0,8"/>
                <TextBlock Text="コードの有効期限（分）" Margin="0,0,0,4"/>
                <TextBox x:Name="ValidMinutesBox" Text="15" Margin="0,0,0,8"/>
                <Button Content="発行する" Click="IssueTempPasswordButton_Click" Margin="0,0,0,8"/>
                <TextBlock x:Name="IssuedCodeText" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,32"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
