<Window x:Class="MedicalSchoolApp.Windows.Views.BlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ブロック中"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        WindowState="Maximized" ShowInTaskbar="False"
        Background="#0F172A">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="480">
            <TextBlock Text="🔒" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
            <TextBlock x:Name="ReasonText" Text="現在は勉強時間中です" FontSize="26" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock Text="ChatGPTのみ使用できます" Foreground="#94A3B8" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,24"/>

            <Button x:Name="OpenChatGptButton" Content="💬 ChatGPTを開く" Height="48" FontSize="15"
                    Background="#3B82F6" Foreground="White" BorderThickness="0" Margin="0,0,0,16"
                    Click="OpenChatGptButton_Click"/>

            <Button x:Name="CancelPseudoRestrictedButton" Content="🧪 疑似制限モードを解除する（テスト用）" Height="48" FontSize="15" FontWeight="Bold"
                    Background="#F59E0B" Foreground="White" BorderThickness="0" Margin="0,0,0,24" Visibility="Collapsed"
                    Click="CancelPseudoRestrictedButton_Click"/>

            <Border Background="#1E293B" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="保護者パスワード または 一時パスワードを入力してください。" Foreground="#94A3B8" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="CodeBox" Padding="8" Background="#0F172A" Foreground="White" BorderBrush="#334155"
                                 KeyDown="CodeBox_KeyDown"/>
                        <Button Grid.Column="2" x:Name="RedeemButton" Content="解除・延長する" Padding="12,8" Background="#3B82F6" Foreground="White" BorderThickness="0"
                                Click="RedeemButton_Click"/>
                    </Grid>
                    <TextBlock x:Name="RedeemMessageText" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
